# API base URL. For LAN development, start-dev.ps1 fills this automatically.
NEXT_PUBLIC_API_URL=http://localhost:8080/api
# Base URL used when generating invite links. Example: http://192.168.100.10:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# LAN host used by Next.js development-origin protection.
NEXT_PUBLIC_APP_HOST=localhost
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123
